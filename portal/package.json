{
  "name": "shotai-portal",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:portal": "vite",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 5175",
    "docs:build": "vitepress build docs",
    "build": "vue-tsc -b && vite build && vitepress build docs && node scripts/finalize-build.mjs",
    "preview": "vite preview",
    "package:static": "npm run build && node scripts/package-static.mjs",
    "check:static": "node scripts/check-static.mjs"
  },
  "dependencies": {
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitepress": "^1.6.4",
    "vue-tsc": "3.3.8"
  }
}
